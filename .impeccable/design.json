  "components": [
    {
      "name": "Pulsante primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "L'azione principale della schermata: inchiostro pieno, testo carta, risposta immediata alla pressione.",
      "html": "<button class=\"ds-btn-primary\">Riprendi lezione</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:10px 20px;background:hsl(var(--primary));color:hsl(var(--primary-foreground));font-family:Montserrat,system-ui,sans-serif;font-size:.875rem;font-weight:600;letter-spacing:-.01em;border:0;border-radius:var(--radius-button);cursor:pointer;transition:transform 120ms var(--ease-out),background-color 180ms ease;}.ds-btn-primary:hover{background:hsl(var(--primary) / .9);}.ds-btn-primary:active{transform:scale(.98);}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background)),0 0 0 4px hsl(var(--ring));}"
    },
    {
      "name": "Pulsante pillola",
      "kind": "button",
      "refersTo": "button-pill",
      "description": "Azione di ripresa a capsula piena: la voce più forte dell'app, una per schermata.",
      "html": "<button class=\"ds-btn-pill\">Riprendi lezione</button>",
      "css": ".ds-btn-pill{display:inline-flex;align-items:center;justify-content:center;height:48px;padding:12px 24px;background:hsl(var(--inverse-surface));color:hsl(var(--inverse-on-surface));font-family:Montserrat,system-ui,sans-serif;font-size:.875rem;font-weight:600;border:0;border-radius:var(--radius-pill);cursor:pointer;transition:transform 120ms var(--ease-out),opacity 180ms ease;}.ds-btn-pill:hover{opacity:.92;}.ds-btn-pill:active{transform:scale(.98);}.ds-btn-pill:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background)),0 0 0 4px hsl(var(--ring));}"
    },
    {
      "name": "Pulsante contorno",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Azione secondaria: superficie della card con un filetto di 1px.",
      "html": "<button class=\"ds-btn-outline\">Carica materiale</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:10px 20px;background:hsl(var(--card));color:hsl(var(--foreground));font-family:Montserrat,system-ui,sans-serif;font-size:.875rem;font-weight:600;border:1px solid hsl(var(--border));border-radius:var(--radius-button);cursor:pointer;transition:background-color 180ms ease,transform 120ms var(--ease-out);}.ds-btn-outline:hover{background:hsl(var(--surface-container-high));}.ds-btn-outline:active{transform:scale(.98);}.ds-btn-outline:focus-visible{outline:none;box-shadow:0 0 0 2px hsl(var(--background)),0 0 0 4px hsl(var(--ring));}"
    },
    {
      "name": "Card di lavoro",
