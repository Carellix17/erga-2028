# Copia questo file in .env.local e compila i valori.
#
# ATTENZIONE: .env è committato nel repo (pubblico) perché Lovable lo genera
# e la build ne ha bisogno. Contiene solo chiavi destinate al browser:
# l'anon key Supabase è pubblica per design, la sicurezza dipende dalle RLS.
#
# Tutto ciò che è davvero segreto (service_role key, API key di terze parti,
# webhook secret) NON va qui né in .env: va in .env.local, che .gitignore
# esclude. Ricorda anche che qualsiasi variabile con prefisso VITE_ finisce
# nel bundle servito ai client: non usare quel prefisso per i segreti.

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
