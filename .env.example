# ──────────────────────────────────────────────────────────────────────────
# Erga — variabili d'ambiente (solo placeholder, NESSUN segreto qui)
# Copia questo file in `.env` e inserisci i valori reali del progetto.
# I valori non vanno mai committati nel repository.
# ──────────────────────────────────────────────────────────────────────────

# Progetto Supabase (Lovable Cloud) — tutti e tre i valori devono puntare
# ALLO STESSO progetto: un mismatch qui fa "login ok ma dati di un altro
# progetto" (l'app sembra vedere un utente nuovo).
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"

# Paddle (test / live) — chiave pubblica, non segreta; separata per modalità.
# Vite carica `.env.development` e `.env.production` DOPO `.env`, quindi
# i valori specifici per modalità vanno messi in quei file.
VITE_PAYMENTS_CLIENT_TOKEN="<paddle-client-token>"
